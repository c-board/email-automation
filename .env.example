NODE_ENV=development

# Required for pnpm start and pnpm run process-inbox. pnpm start also requires SUMMARY_RECIPIENT.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

AUTO_ACTION_CONFIDENCE=0.95
REVIEW_CONFIDENCE=0.80

DRY_RUN=true

TIMEZONE=America/Chicago
GMAIL_FETCH_LIMIT=20
MAX_EMAIL_BODY_CHARS=30000
PROTECTED_COMPANIES=Grainger
LOG_LEVEL=info

DATABASE_URL=file:./data/email-automation.sqlite

# Required by pnpm start and pnpm run send-summary. SMTP username and password are required only when DRY_RUN=false.
SUMMARY_RECIPIENT=
FASTMAIL_SMTP_HOST=smtp.fastmail.com
FASTMAIL_SMTP_PORT=465
FASTMAIL_USERNAME=
FASTMAIL_PASSWORD=

# Schedules in TIMEZONE. Used by pnpm start. Nothing runs at startup.
INBOX_PROCESSING_CRON=*/30 * * * *
SUMMARY_CRON=0 18 * * *
