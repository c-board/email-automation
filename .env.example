NODE_ENV=development

# Required for pnpm start and pnpm run process-inbox. Both also require SUMMARY_RECIPIENT.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

AUTO_ACTION_CONFIDENCE=0.95
REVIEW_CONFIDENCE=0.80

DRY_RUN=true

TIMEZONE=America/Chicago
GMAIL_FETCH_LIMIT=20
MAX_EMAIL_BODY_CHARS=30000
PROTECTED_COMPANIES=Grainger
LOG_LEVEL=info

DATABASE_URL=file:./data/email-automation.sqlite

# Required by pnpm start, pnpm run process-inbox, and pnpm run send-summary.
# RESEND_API_KEY and RESEND_FROM are required only when DRY_RUN=false.
# RESEND_FROM must be a sender verified in Resend. The summary is still delivered to SUMMARY_RECIPIENT.
SUMMARY_RECIPIENT=
RESEND_API_KEY=
RESEND_FROM=

# Inbox schedule in TIMEZONE. Used by pnpm start. Nothing runs at startup.
# Each run classifies new mail, then sends the summary and archives confirmations.
INBOX_PROCESSING_CRON=*/30 * * * *
