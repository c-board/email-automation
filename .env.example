NODE_ENV=development

# Required for pnpm start and pnpm run process-inbox
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

AUTO_ACTION_CONFIDENCE=0.95
REVIEW_CONFIDENCE=0.80

DRY_RUN=true

TIMEZONE=America/Chicago
GMAIL_FETCH_LIMIT=20
MAX_EMAIL_BODY_CHARS=30000
PROTECTED_COMPANIES=Grainger
LOG_LEVEL=info

DATABASE_URL=file:./data/email-automation.sqlite

# Later milestones. Not read by this version.
# FASTMAIL_SMTP_HOST=
# FASTMAIL_SMTP_PORT=
# FASTMAIL_USERNAME=
# FASTMAIL_PASSWORD=
# SUMMARY_RECIPIENT=
# SUMMARY_CRON=
# INBOX_PROCESSING_CRON=
