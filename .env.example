NODE_ENV=development

# Required for pnpm start and pnpm run process-inbox
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

AUTO_ACTION_CONFIDENCE=0.95
REVIEW_CONFIDENCE=0.80

DRY_RUN=true

TIMEZONE=America/Chicago
GMAIL_FETCH_LIMIT=20
MAX_EMAIL_BODY_CHARS=30000
PROTECTED_COMPANIES=Grainger
LOG_LEVEL=info

DATABASE_URL=file:./data/email-automation.sqlite

# Required by pnpm run send-summary. SMTP username and password are required only when DRY_RUN=false.
SUMMARY_RECIPIENT=
FASTMAIL_SMTP_HOST=smtp.fastmail.com
FASTMAIL_SMTP_PORT=465
FASTMAIL_USERNAME=
FASTMAIL_PASSWORD=

# Later milestones. Not read by this version.
# SUMMARY_CRON=
# INBOX_PROCESSING_CRON=
